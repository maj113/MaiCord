{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "x64-release",
      "generator": "Ninja",
      "binaryDir": "${sourceParentDir}/MaiCord-build/Release/cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MAICORD_BUILD_TESTS": false,
        "MAICORD_UNWIND_TABLES": false
      }
    }
  ]
}