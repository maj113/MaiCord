pkgbase = maicord
	pkgdesc = A lightweight, native Discord client (unofficial), built from source
	pkgver = 0.6.6
	pkgrel = 1
	url = https://maicord.com/
	arch = x86_64
	license = MPL-2.0
	makedepends = git
	makedepends = cmake
	makedepends = ninja
	makedepends = python
	makedepends = clang
	makedepends = lld
	makedepends = llvm
	makedepends = gcc
	depends = glibc
	depends = openssl
	depends = wayland
	depends = libxkbcommon
	depends = libglvnd
	depends = hicolor-icon-theme
	optdepends = mesa: OpenGL ES drivers for the GPU (llvmpipe without one); your GPU vendor's driver works too
	optdepends = libpulse: voice, notification and media audio (PulseAudio, or PipeWire with pipewire-pulse)
	optdepends = speech-dispatcher: text-to-speech for "Speak message"
	optdepends = libfido2: security keys for two-factor sign-in (and the udev rules for hidraw access)
	optdepends = fontconfig: system fonts and the fallback for scripts the bundled fonts lack
	optdepends = noto-fonts-emoji: colour emoji
	optdepends = noto-fonts-cjk: Chinese, Japanese and Korean text
	optdepends = hunspell: spell checking
	optdepends = hunspell-en_us: English dictionary for spell checking (any Hunspell dictionary of your language)
	optdepends = enchant: spell checking through Enchant when Hunspell is not installed
	optdepends = xdg-desktop-portal: file chooser, settings and global shortcut portals
	optdepends = gnome-keyring: Secret Service to keep the sign-in key (KeePassXC and KWallet work too)
	provides = maicord
	conflicts = maicord-bin
	options = !buildflags
	options = !strip
	options = !debug
	options = !lto
	source = git+https://github.com/maj113/MaiCord.git#tag=v0.6.6
	sha256sums = SKIP

pkgname = maicord
