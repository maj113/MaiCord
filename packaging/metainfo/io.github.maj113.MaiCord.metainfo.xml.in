<?xml version="1.0" encoding="UTF-8"?>
<!-- The AppStream metadata of MaiCord (https://www.freedesktop.org/software/appstream/docs/). @RELEASES@ is replaced by
     packaging/build_tarball.py with the <releases> element of the version being packaged; every other packaging
     format installs the generated file. -->
<component type="desktop-application">
  <id>io.github.maj113.MaiCord</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>

  <name>MaiCord</name>
  <summary>A lightweight, native Discord client</summary>
  <developer id="io.github.maj113">
    <name>maj113</name>
  </developer>

  <description>
    <p>
      MaiCord is an unofficial Discord client written from scratch in C++. It shapes its own text and draws its own
      interface on the GPU: there is no Electron, no browser engine and no web view.
    </p>
    <p>
      It does chat, voice and video, with notifications, a tray icon and saved accounts, and installs plugins, themes and
      animated backgrounds from a signed catalog. On Linux it is a native Wayland client drawing with OpenGL ES, and it
      plays and records audio through PulseAudio or PipeWire.
    </p>
    <p>
      MaiCord is not affiliated with, endorsed by or supported by Discord Inc. Using a third-party client may violate
      Discord's Terms of Service and could put your account at risk.
    </p>
  </description>

  <launchable type="desktop-id">io.github.maj113.MaiCord.desktop</launchable>

  <url type="homepage">https://maicord.com/</url>
  <url type="bugtracker">https://github.com/maj113/MaiCord/issues</url>
  <url type="vcs-browser">https://github.com/maj113/MaiCord</url>
  <url type="contribute">https://github.com/maj113/MaiCord/blob/master/CONTRIBUTING.md</url>

  <!-- TODO(owner): screenshots. AppStream validation and Flathub require at least one; take them on Linux (the Wayland
       window), 16:9 PNGs of at least 1248x702, with personal data and server content redacted, commit them (for example
       under .github/assets/screenshots/) and point the URLs at the raw files of a tag (not of master, which changes).
       Remove this comment and the placeholder entry when the real ones are in. -->
  <screenshots>
    <screenshot type="default">
      <caption>The chat view</caption>
      <image type="source">https://raw.githubusercontent.com/maj113/MaiCord/master/.github/assets/screenshots/chat.png</image>
    </screenshot>
  </screenshots>

  <!-- TODO(owner): review the content rating. Discord is unmoderated chat and voice between people. -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <keywords>
    <keyword>Discord</keyword>
    <keyword>Chat</keyword>
    <keyword>Voice</keyword>
    <keyword>Messaging</keyword>
  </keywords>

  <provides>
    <binary>MaiCord</binary>
    <mediatype>x-scheme-handler/discord</mediatype>
    <mediatype>x-scheme-handler/maicord</mediatype>
  </provides>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <requires>
    <display_length compare="ge">640</display_length>
  </requires>

  @RELEASES@
</component>
