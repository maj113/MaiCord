     %changelog entry); `osc service remoterun` or a commit runs it. -->
<services>
  <service name="download_url">
    <param name="url">https://github.com/maj113/MaiCord/releases/download/v0.6.6/maicord-0.6.6-linux-x86_64.tar.gz</param>
  </service>
</services>
